# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
e2e/screenshots/
e2e/*.png

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database (contains real data, too large for git)
sqlite.db

# database runtime artifacts
sqlite.db-*

# local runtime logs
server.log
dev.log

# codebase analysis artifacts
.codebase-memory/

# temporary workflow/test helpers
workflow-summary.txt
playwright.config.pure.ts

# generated screenshots
/tests/screenshots/

# IDE
.idea/

# OS
Thumbs.db

# Playwright CLI artifacts
.playwright-cli/
.playwright-mcp/
.playwright/

# Pi agent artifacts
.pi/
